{
  "name": "dsh-whalegirl-lyric",
  "version": "1.0.0",
  "description": "DSH Web GUI 插件：鲸鱼娘形象 + 洛雪音乐歌词气泡，支持播放控制与 SSE 即时同步。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "lx-music",
    "lyrics",
    "desktop-lyrics",
    "whalegirl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xixifu018/LyricDisplay.git",
    "directory": "plugins/dsh-whalegirl-lyric"
  },
  "bugs": {
    "url": "https://github.com/xixifu018/LyricDisplay/issues"
  },
  "homepage": "https://github.com/xixifu018/LyricDisplay/tree/main/plugins/dsh-whalegirl-lyric#readme",
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": []
    }
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1"
  }
}
